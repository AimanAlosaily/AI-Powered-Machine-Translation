{
  "name": "verta-context-translation",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prepare:offline-assets": "node scripts/prepare-offline-assets.mjs",
