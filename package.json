    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/compact-model.browser.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "@tesseract.js-data/ara": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "buffer": "6.0.3",
    "docx": "9.5.1",
    "drizzle-orm": "0.45.2",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "next": "16.2.6",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
